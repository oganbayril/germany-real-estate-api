# Copy to .env and adjust. All vars are prefixed RE_.

# --- Database ---
# Local dev default is SQLite; production uses Postgres:
# RE_DATABASE_URL=postgresql+psycopg://realestate:CHANGME@localhost:5432/realestate
RE_DATABASE_URL=sqlite+pysqlite:///./data/realestate.db

# --- Scraper ---
RE_SCRAPE_CITIES=berlin,muenchen,hamburg,koeln,leipzig
RE_SCRAPE_DELAY_MIN_S=5
RE_SCRAPE_DELAY_MAX_S=10
RE_SCRAPE_MAX_PAGES_PER_CITY=5

# --- Logging ---
RE_LOG_LEVEL=INFO
