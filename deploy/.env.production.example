# Copy to /opt/realestate/.env and `chmod 600`. setup.sh generates the DB
# password and fills RE_DATABASE_URL if this file is absent when it runs.

RE_DATABASE_URL=postgresql+psycopg://realestate:CHANGEME@localhost:5432/realestate
RE_DATA_DIR=/opt/realestate/data
RE_MODEL_DIR=/opt/realestate/models
RE_LOG_LEVEL=INFO

# The DuckDNS (or other) hostname pointed at this box. Used by the Caddyfile.
RE_PUBLIC_DOMAIN=germany-real-estate.duckdns.org

# Slugs from src/realestate/cities.py. A new city is scraped and trained on at
# once, but only offered on the demo page once the live model has learned from
# RE_MIN_CITY_ROWS of its listings.
RE_SCRAPE_CITIES=berlin,muenchen,hamburg,koeln,leipzig,frankfurt,stuttgart,duesseldorf,dresden,hannover
RE_MIN_CITY_ROWS=150
# Gentle on purpose: DataDome scores IPs over time. Raising the delay from
# 25-45s to 45-90s on 2026-10-03 roughly tripled pages fetched before a block
# (4-7 -> 12) on two of three runs, so pushed it further still on 2026-10-12.
# No rush running unattended on the VPS -- 10 cities x 5 pages at 120-240s is
# ~2.5h, inside TimeoutStartSec=5h on the systemd unit.
RE_SCRAPE_DELAY_MIN_S=120
RE_SCRAPE_DELAY_MAX_S=240
RE_SCRAPE_MAX_SEARCH_URLS_PER_CITY=5
RE_SCRAPE_DISCOVERY_CACHE_DAYS=14
RE_MIN_TRAIN_ROWS=200
# Don't deploy a retrain whose hold-out median % error is more than this many
# points worse than the live model's (override once with realestate-train --force).
RE_MAX_ERROR_REGRESSION_PTS=3
# Model types the weekly retrain chooses between (src/realestate/model/candidates.py),
# and the city-only median-error lead (points) needed to switch the live type.
RE_TRAIN_CANDIDATES=xgboost,hist_gradient_boosting,random_forest,linear_regression
RE_TRAIN_SWITCH_MARGIN_PTS=1

# Run-summary emails (reuse the shared Gmail app password). Leave the password
# blank to disable email entirely.
RE_SMTP_HOST=smtp.gmail.com
RE_SMTP_PORT=587
RE_SMTP_USER=oganby@gmail.com
RE_SMTP_PASSWORD=
RE_EMAIL_TO=oganbayril.dev@gmail.com
