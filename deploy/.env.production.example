# Copy to /opt/realestate/.env and `chmod 600`. setup.sh generates the DB
# password and fills RE_DATABASE_URL if this file is absent when it runs.

RE_DATABASE_URL=postgresql+psycopg://realestate:CHANGEME@localhost:5432/realestate
RE_DATA_DIR=/opt/realestate/data
RE_MODEL_DIR=/opt/realestate/models
RE_LOG_LEVEL=INFO

# The DuckDNS (or other) hostname pointed at this box. Used by the Caddyfile.
RE_PUBLIC_DOMAIN=germany-real-estate.duckdns.org

RE_SCRAPE_CITIES=berlin,muenchen,hamburg,koeln,leipzig
RE_SCRAPE_DELAY_MIN_S=8
RE_SCRAPE_DELAY_MAX_S=15
RE_SCRAPE_MAX_SEARCH_URLS_PER_CITY=40
RE_MIN_TRAIN_ROWS=200

# Run-summary emails (reuse the shared Gmail app password). Leave the password
# blank to disable email entirely.
RE_SMTP_HOST=smtp.gmail.com
RE_SMTP_PORT=587
RE_SMTP_USER=oganby@gmail.com
RE_SMTP_PASSWORD=
RE_EMAIL_TO=oganby@gmail.com
