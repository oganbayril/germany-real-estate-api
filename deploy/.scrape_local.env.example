# Local scraper config. Copy to deploy/.scrape_local.env (gitignored) and fill in.
# The scraper runs from this PC (Immowelt's DataDome blocks the VPS IP) and writes
# into the VPS Postgres through an SSH tunnel.

VPS_SSH=root@89.167.25.74

# The DB password. On the VPS:
#   grep RE_DATABASE_URL /opt/realestate/.env
# copy the part between "realestate:" and "@localhost".
RE_DB_PASSWORD=

# Run-summary email (same shared Gmail app password as the VPS .env).
RE_SMTP_HOST=smtp.gmail.com
RE_SMTP_PORT=587
RE_SMTP_USER=oganby@gmail.com
RE_SMTP_PASSWORD=
RE_EMAIL_TO=oganby@gmail.com

RE_SCRAPE_CITIES=berlin,muenchen,hamburg,koeln,leipzig
RE_SCRAPE_MAX_SEARCH_URLS_PER_CITY=40
