# Reverse proxy + automatic HTTPS for the real-estate API.
# setup.sh installs this as /etc/caddy/sites-enabled/realestate.conf through
# vps-infra's add-site, which puts $RE_PUBLIC_DOMAIN in as the site address:
#   add-site realestate deploy/Caddyfile germany-real-estate.oganbayril.com
# Caddy obtains and renews the TLS certificate itself.
#
# Rate limiting lives in the app (slowapi), so this needs only the stock Caddy
# binary -- no plugins.

__DOMAIN__ {
	encode zstd gzip

	# The API never accepts a body larger than a small JSON object.
	request_body {
		max_size 16KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/realestate.log
		format json
	}
}
