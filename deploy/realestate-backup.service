[Unit]
Description=Nightly pg_dump of the realestate database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=realestate
Group=realestate
EnvironmentFile=/opt/realestate/.env
ExecStart=/bin/bash /opt/realestate/deploy/realestate-backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/realestate/backups
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
