[Unit]
Description=Scrape Immowelt listings into the database
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=realestate
Group=realestate
WorkingDirectory=/opt/realestate
EnvironmentFile=/opt/realestate/.env
ExecStart=/opt/realestate/.venv/bin/realestate-scrape run --email
# ~3 min per page at the gentle delay: 10 cities x 5 pages is ~2.5h, plus a
# sitemap walk when the URL pool is rebuilt. A kill mid-run would leave the
# run row stuck at "running".
TimeoutStartSec=5h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/realestate/data
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
